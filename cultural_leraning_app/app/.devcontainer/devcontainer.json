{
  "name": "Flutter Web Development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/cultural_leraning_app/app",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "dart.flutterSdkPath": "/home/vscode/flutter"
      }
    }
  },
  "containerEnv": {
    "PATH": "/home/vscode/flutter/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },
  "forwardPorts": [8080],
  "postCreateCommand": "flutter config --enable-web && flutter pub get",
  "remoteUser": "vscode"
}