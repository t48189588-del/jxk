{
  "name": "Flutter Cultural Suite DevContainer",
  "image": "ghcr.io/cirruslabs/flutter:latest",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "dart.lineLength": 100
      }
    }
  },
  "forwardPorts": [8080, 3000],
  "portsAttributes": {
    "8080": {
      "label": "Flutter Web App",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "flutter pub get && flutter doctor"
}